# Copy to apps/orchestrator/.env. Offline mode never contacts providers.
OFFLINE_MODE=true
PORT=4000
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_DB_NAME=crowdtwin
# Publisher identity token for the configured database, never expose to Vite/browser.
SPACETIMEDB_TOKEN=
APIFY_API_TOKEN=
ANTHROPIC_API_KEY=
FACTORY_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Live providers and coordination are independent. droid requires a passing tool-boundary check.
COORDINATOR_MODE=droid
DROID_EXEC_PATH=droid
DROID_MODEL=claude-sonnet-4-6
# Listen address and browser origins. Hosted mode must use HTTPS at the ingress.
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
# Set NODE_ENV=production for hosted deployment and configure a private shared login.
# Username: demo. Password is required in production (at least 16 characters).
DEMO_PASSWORD=
# Durable volume directory. Run one orchestrator replica.
DATA_DIR=
