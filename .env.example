# Copy to apps/orchestrator/.env. Offline mode never contacts providers.
OFFLINE_MODE=true
PORT=4000
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_DB_NAME=crowdtwin
# Local publisher identity token, never expose to Vite/browser.
SPACETIMEDB_TOKEN=
APIFY_API_TOKEN=
ANTHROPIC_API_KEY=
FACTORY_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
