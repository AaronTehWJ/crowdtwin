{
  "name": "@crowdtwin/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@crowdtwin/contracts": "0.1.0",
    "@factory/droid-sdk": "0.10.0",
    "apify-client": "2.20.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "spacetimedb": "1.12.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "esbuild": "0.25.12"
  }
}
