# Public build-time settings only. Never put provider keys or database tokens here.
# Blank uses the same-origin API, which also supplies the database URL/name at runtime.
VITE_API_BASE_URL=
VITE_SPACETIMEDB_URI=
VITE_SPACETIMEDB_DB_NAME=
# Vite development proxy (not included in the browser bundle).
API_PROXY_TARGET=http://127.0.0.1:4000
